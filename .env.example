# Public site URL (canonical URLs, sitemap, JSON-LD, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.axonadhd.com

# ── Contact form (POST /api/contact) ─────────────────────────────
# Where contact submissions are delivered. If unset (or no provider below
# is configured) submissions are logged to the server console instead.
CONTACT_TO_EMAIL=support@axonadhd.com
CONTACT_FROM_EMAIL="AXON ADHD Website <no-reply@axonadhd.com>"

# Option 1 — Resend (preferred). Verify the sending domain in Resend first.
RESEND_API_KEY=

# Option 2 — SMTP via Nodemailer (used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Newsletter (POST /api/newsletter) ────────────────────────────
# "console" (default, logs only) or "mailchimp". Add more adapters in src/lib/newsletter.ts.
NEWSLETTER_PROVIDER=console
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
